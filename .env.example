# ---------------------------------------------------------------------------

# Required: market data + LLM brain

# ---------------------------------------------------------------------------

# Tavily API key (scrapers). Get one at https://tavily.com

TAVILY_API_KEY=



# Afrikia LLM provider (OpenAI-compatible). Required.
AFRIKIA_API_KEY=
# AFRIKIA_BASE_URL=https://afrikia.neobytech.net/v1
# AFRIKIA_MODEL=nemotron-3-nano
# Fallback models tried in order when the primary is unavailable:
# AFRIKIA_FALLBACK_MODELS=qwen2.5-7b

# Optional: Ollama Cloud key, used ONLY by the scraper web_fetch fallback
# when Tavily fails (app/utils/ollama_web.py). The chat LLM never uses Ollama.
# OLLAMA_API_KEY=

LLM_TEMPERATURE=0.5




# Shared secret trusted clients send as X-API-Key to the Chat API (/chat).

# REQUIRED in production — if empty, the API accepts unauthenticated requests.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"

API_SECRET_KEY=



# Port the Chat API listens on. Default 8000 — change if another service

# on the host already uses it. With docker compose, this sets the published

# host port (the container-to-container port stays 8000).

# API_PORT=8000

# Host interface the API port is published on (docker compose). Default

# 127.0.0.1 = only this machine. Set 0.0.0.0 ONLY if external clients must

# reach the API directly — and then API_SECRET_KEY is mandatory. When the

# mobile app reaches the API through the Cloudflare tunnel below, the

# localhost default is enough even in production.

# API_BIND=127.0.0.1

# Optional Cloudflare Tunnel: outbound-only public ingress for the mobile app,

# no host port to expose. Create the tunnel in the Zero Trust dashboard

# (public hostname -> http://api:8000), put its token here, then start with

# `docker compose --profile tunnel up -d`.

# CLOUDFLARE_TUNNEL_TOKEN=

# Server timezone. The BRVM trades on GMT (Abidjan); set this so date cutoffs,

# cache staleness and the agent's "current time" match the market.

# TZ=Africa/Abidjan



# ---------------------------------------------------------------------------

# Production database (PostgreSQL)

# ---------------------------------------------------------------------------

# Password for the bundled PostgreSQL service (docker compose only).

POSTGRES_PASSWORD=

# Full connection string. docker compose sets this automatically from

# POSTGRES_PASSWORD. Leave EMPTY for local SQLite files in app/data/ (dev).

# DATABASE_URL=postgresql://brvm:<password>@localhost:5432/brvm



# ---------------------------------------------------------------------------

# Optional tuning (defaults shown — uncomment to change)

# ---------------------------------------------------------------------------

# SCRAPER_SLEEP_SECONDS=2          # pause between scraper requests

# BRVM_VERIFY_SSL=true             # set false only for certificate-chain issues

# PALMARES_CACHE_TTL_SECONDS=300   # market data scrape interval (stale cache served on failure)

# MAX_CONCURRENT_AGENTS=4          # concurrent agent runs on the Chat API

# AGENT_QUEUE_TIMEOUT=60           # seconds a request waits for a free agent slot

# RATE_LIMIT_PER_MINUTE=30         # per-user /chat rate limit (0 disables)

# DAILY_FREE_QUOTA=30              # free requests per user per day (0 = unlimited; failures refunded)

# QUOTA_EXEMPT_IDS=user-123        # comma-separated /chat user ids with no quota

# TIMESERIES_SYMBOLS=NTLC,SLBC     # default: all symbols from BRVM_Companies.xlsx

# RECURSION_LIMIT=30               # max agent steps before a partial answer

# LLM_REQUEST_TIMEOUT=120          # per-request LLM timeout in seconds

# LLM_MAX_RETRIES=1                # client-level LLM retries (graph adds 1 more on transient errors)

# LLM_THINKING=0                   # 1 re-enables reasoning chain-of-thought (nemotron); ~5x slower per call

# MEMORY_TTL_HOURS=24              # wipe conversations inactive for this long (0 = keep until /clear-memory)

# MEMORY_CLEANUP_INTERVAL_SEC=3600 # how often the stale-conversation cleanup runs

# MEMORY_MAX_MESSAGES=20           # condensed messages kept per conversation (20 = 10 exchanges)

# SGI_REFRESH_DAYS=7               # docker: refresh broker list when older than N days

# COMPANY_DETAILS_REFRESH_DAYS=7   # docker: refresh company fiches (fundamentals) older than N days

# SCORING_TECHNICAL_WEIGHT=0.6     # advisor engine: weight of technicals (trend/momentum/RSI/risk/volume)

# SCORING_FUNDAMENTAL_WEIGHT=0.4   # advisor engine: weight of fundamentals (growth/PER/dividend)

# DIGEST_ENABLED=true              # scheduled buy/sell digest for subscribers

# DIGEST_HOUR_GMT=18               # digest send time (weekdays; weekly edition on Friday)

# SIKA_TABS_ENABLED=true           # weekly fetch of Sika COURS/ANALYSE/SECTEUR tabs via Tavily (~150 credits/wk)


# --- Mobile app (Flutter) ---

# JWT_SECRET=                     # REQUIRED for the mobile app: openssl rand -hex 32. Empty = /mobile/v1/* disabled (503)

# JWT_ACCESS_TTL_SECONDS=900      # access token lifetime (15 min)

# JWT_REFRESH_TTL_SECONDS=2592000 # refresh token lifetime (30 days)

# AUTH_PROVIDER=smtp              # OTP delivery: smtp | mock (mock = code returned in API response; dev/tests ONLY)

# PASSWORD_MIN_LENGTH=6           # minimum password length for mobile accounts (any character mix)

# OTP_TTL_SECONDS=600             # login code validity

# OTP_MAX_ATTEMPTS=5              # verify attempts per code

# OTP_RESEND_COOLDOWN_SECONDS=60  # minimum delay between code requests

# SMTP_HOST=                      # email OTP delivery (required for email login when AUTH_PROVIDER=smtp)

# SMTP_PORT=587

# SMTP_USER=

# SMTP_PASSWORD=

# SMTP_FROM=                      # defaults to SMTP_USER

# SMS_PROVIDER=                   # phone OTP delivery: twilio | (empty = phone login disabled)

# TWILIO_ACCOUNT_SID=

# TWILIO_AUTH_TOKEN=

# TWILIO_FROM_NUMBER=             # E.164, e.g. +15551234567

# FIREBASE_CREDENTIALS=           # FCM push: service-account JSON path or inline JSON (empty = push disabled)

# Public ingress for the mobile app: put the API behind TLS (e.g. a Cloudflare
# Tunnel or reverse proxy) exposing only /mobile/v1/*, /chat and /health. The
# mobile client never uses API_SECRET_KEY — end users authenticate with
# e-mail/phone + password (JWT bearer tokens).
