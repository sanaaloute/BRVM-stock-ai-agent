# ---------------------------------------------------------------------------

# Required: market data + LLM brain

# ---------------------------------------------------------------------------

# Tavily API key (scrapers). Get one at https://tavily.com

TAVILY_API_KEY=



# LLM provider: ollama | groq | openrouter

LLM_PROVIDER=ollama

# Fallback provider tried once when the primary's upstream is down/overloaded

# (both providers need their keys configured below). Empty = no fallback.

# LLM_FALLBACK_PROVIDER=ollama

# Optional overrides for the selected provider

OLLAMA_MODEL=qwen3:8b   # local Ollama model (ignored when OLLAMA_CLOUD=true)

LLM_TEMPERATURE=0.5



# --- Ollama (when LLM_PROVIDER=ollama) ---

# OLLAMA_MODEL=llama3.2:3b

# OLLAMA_BASE_URL=http://127.0.0.1:11434

# OLLAMA_KEEP_ALIVE=2m



# Ollama Cloud instead of a local GPU (https://ollama.com/settings/keys):

# OLLAMA_CLOUD=true

# OLLAMA_API_KEY=

# OLLAMA_CLOUD_MODEL=gpt-oss:120b  # bare tag (no :cloud suffix). Free-tier keys

#                                  # cannot run paid models (glm-5.2, qwen3.5:397b,

#                                  # kimi-k2.6, ...). List what YOUR key can run:

#                                  # curl https://ollama.com/api/tags -H "Authorization: Bearer $OLLAMA_API_KEY"



# --- Groq (when LLM_PROVIDER=groq). https://console.groq.com/keys ---

# GROQ_API_KEY=

# GROQ_MODEL=openai/gpt-oss-120b



# --- OpenRouter (when LLM_PROVIDER=openrouter). https://openrouter.ai/settings/keys ---

# OPENROUTER_API_KEY=

# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free





# ---------------------------------------------------------------------------

# Required: Telegram bot

# ---------------------------------------------------------------------------

# Bot token from @BotFather

TELEGRAM_BOT_TOKEN=

# Optional: route Bot API calls through a Cloudflare Worker reverse proxy when

# api.telegram.org is unreachable from the host (e.g. mainland China) and a

# system-wide VPN is not an option. Deploy cloudflare/telegram-api-proxy/

# (see README "Running the bot where Telegram is blocked") and set:

# TELEGRAM_BASE_URL=https://telegram-api-proxy.<your-subdomain>.workers.dev



# Shared secret the bot sends as X-API-Key to the Chat API.

# REQUIRED in production — if empty, the API accepts unauthenticated requests.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"

API_SECRET_KEY=



# Port the Chat API listens on. Default 8000 — change if another service

# on the host already uses it. With docker compose, this sets the published

# host port (the container-to-container port stays 8000).

# API_PORT=8000

# Host interface the API port is published on (docker compose). Default

# 127.0.0.1 = only this machine. Set 0.0.0.0 ONLY if the Meta WhatsApp webhook

# or another external client must reach the API — and then API_SECRET_KEY is

# mandatory (Telegram + Evolution do NOT need this; they talk inside the

# compose network).

# API_BIND=127.0.0.1

# Server timezone. The BRVM trades on GMT (Abidjan); set this so date cutoffs,

# cache staleness and the agent's "current time" match the market.

# TZ=Africa/Abidjan



# Chat API URL the bot calls. Default http://localhost:8000

# (docker compose sets this to http://api:8000 automatically)

# BRVM_API_URL=http://localhost:8000



# ---------------------------------------------------------------------------

# Production database (PostgreSQL)

# ---------------------------------------------------------------------------

# Password for the bundled PostgreSQL service (docker compose only).

POSTGRES_PASSWORD=

# Full connection string. docker compose sets this automatically from

# POSTGRES_PASSWORD. Leave EMPTY for local SQLite files in app/data/ (dev).

# DATABASE_URL=postgresql://brvm:<password>@localhost:5432/brvm



# ---------------------------------------------------------------------------

# Optional: WhatsApp Business Cloud API channel

# All three required to enable. Webhook: GET/POST /whatsapp/webhook (public HTTPS).

# ---------------------------------------------------------------------------

# WHATSAPP_VERIFY_TOKEN=choose-a-random-string

# WHATSAPP_ACCESS_TOKEN=EAAG...

# WHATSAPP_PHONE_NUMBER_ID=123456789012345

# Meta App Secret (Meta app > Settings > Basic). REQUIRED: verifies the

# X-Hub-Signature-256 HMAC on inbound webhooks. Without it the channel stays

# disabled — an unverified webhook lets anyone inject messages as any phone.

# WHATSAPP_APP_SECRET=

# WHATSAPP_DEDUP_TTL_SECONDS=86400  # dedup window for Meta delivery retries



# ---------------------------------------------------------------------------

# Optional: WhatsApp via Evolution API channel (self-hosted, bundled in

# docker-compose.yml as the `evolution` service). EVOLUTION_API_KEY is a

# secret YOU choose — Evolution uses it to protect its API and to sign webhook

# deliveries. docker compose overrides EVOLUTION_URL to the service name; set

# it to http://localhost:8080 only for non-Docker runs. Webhook (one-time,

# see README): http://api:8000/whatsapp/evolution/webhook

# ---------------------------------------------------------------------------

# EVOLUTION_URL=http://localhost:8080

# EVOLUTION_API_KEY=choose-a-strong-random-string

# EVOLUTION_INSTANCE=brvm-bot

# NOTE: docker-compose.yml pins Evolution to v2.3.7, which needs NO license
# activation. The v2.4.0+ images require a one-time FREE license activation
# (register name/email/phone at http://localhost:8080/manager/login via SSH
# tunnel); the license key is persisted in the evolution DB, so it survives
# restarts. If you ever upgrade past v2.3.7, set this (after a first manual
# registration) to auto-activate headlessly on fresh installs.
# EVOLUTION_OPERATOR_EMAIL=you@example.com



# ---------------------------------------------------------------------------

# Optional tuning (defaults shown — uncomment to change)

# ---------------------------------------------------------------------------

# SCRAPER_SLEEP_SECONDS=2          # pause between scraper requests

# BRVM_VERIFY_SSL=true             # set false only for certificate-chain issues

# PALMARES_CACHE_TTL_SECONDS=300   # market data scrape interval (stale cache served on failure)

# MAX_CONCURRENT_AGENTS=4          # concurrent agent runs on the Chat API

# AGENT_QUEUE_TIMEOUT=60           # seconds a request waits for a free agent slot

# RATE_LIMIT_PER_MINUTE=30         # per-user /chat rate limit (0 disables)

# DAILY_FREE_QUOTA=30              # free requests per user per day (0 = unlimited; failures refunded)

# QUOTA_EXEMPT_IDS=123456789       # comma-separated ids with no quota (Telegram id or wa:225...)

# TIMESERIES_SYMBOLS=NTLC,SLBC     # default: all symbols from BRVM_Companies.xlsx

# RECURSION_LIMIT=30               # max agent steps before a partial answer

# LLM_REQUEST_TIMEOUT=120          # per-request LLM timeout in seconds

# LLM_MAX_RETRIES=1                # client-level LLM retries (graph adds 1 more on transient errors)

# MEMORY_TTL_HOURS=24              # wipe conversations inactive for this long (0 = keep until /clearmemory)

# MEMORY_CLEANUP_INTERVAL_SEC=3600 # how often the stale-conversation cleanup runs

# MEMORY_MAX_MESSAGES=20           # condensed messages kept per conversation (20 = 10 exchanges)

# WHISPER_MODEL=small              # voice notes: local whisper model (tiny|base|small|medium)

# WHISPER_COMPUTE_TYPE=int8        # int8 = low RAM on CPU; use float16 on GPU

# SGI_REFRESH_DAYS=7               # docker: refresh broker list when older than N days

# COMPANY_DETAILS_REFRESH_DAYS=7   # docker: refresh company fiches (fundamentals) older than N days

# SCORING_TECHNICAL_WEIGHT=0.6     # advisor engine: weight of technicals (trend/momentum/RSI/risk/volume)

# SCORING_FUNDAMENTAL_WEIGHT=0.4   # advisor engine: weight of fundamentals (growth/PER/dividend)

# DIGEST_ENABLED=true              # Telegram: scheduled buy/sell digest for /digest subscribers

# DIGEST_HOUR_GMT=18               # digest send time (weekdays; weekly edition on Friday)

# SIKA_TABS_ENABLED=true           # weekly fetch of Sika COURS/ANALYSE/SECTEUR tabs via Tavily (~150 credits/wk)

